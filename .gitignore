# Data: nothing from raw/ or processed/ is committed by default.
# A source is allow-listed here only after its redistribution right is
# confirmed in an ADR, e.g.:
#   !data/raw/<source>/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Simulation outputs (regenerable)
results/

# Editors / OS
.DS_Store
.idea/
.vscode/
